[Version]
Signature="$Windows NT$"
Class=USBDevice
ClassGUID={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%ManufacturerName%
CatalogFile=winusb.cat
DriverVer=09/28/2026,1.0.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=USB_Install, USB\VID_0781&PID_5590

[ClassInstall32]
AddReg=ClassInstall_AddReg

[ClassInstall_AddReg]
HKR,,,0,%ClassName%
HKR,,Icon,,-20

[USB_Install.NTamd64]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.NTamd64.Services]
Include=winusb.inf
Needs=WINUSB.NT.Services

[USB_Install.NTamd64.HW]
AddReg=Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x00010000,"{A5DCBF10-6530-11D2-901F-00C04FB951ED}"

[Strings]
ManufacturerName="Generic USBIP Engine"
ClassName="USB Devices"
DeviceName="USBIP Shared Hardware Device"